# ============================================================
# 环境变量模板：复制为 .env 后填入自己的值
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# .env 已在 .gitignore 中，不会被提交；系统环境变量优先级高于 .env。
# 不想用 .env 也可以复制 config_local.example.py 为 config_local.py。
# ============================================================

# ---- 必填：大模型 API Key（留空则自动进入离线 Mock 模式，可跑通流程但回答为模拟内容）----
OPENAI_API_KEY=

# ---- 选填：OpenAI 兼容接口地址（用 OpenAI 官方则留空）----
# DeepSeek:      https://api.deepseek.com/v1
# 通义/其他平台: 按平台文档填写，只到 /v1 为止
OPENAI_BASE_URL=

# ---- 选填：模型 ID（不填则用 config.py 默认值 DeepSeek-V4-Flash）----
LLM_MODEL=DeepSeek-V4-Flash

# ============================================================
# Embedding（RAG 检索精度关键；不配置也能跑，但会回退词面哈希向量）
# ============================================================
# 后端：auto（默认，先远程后本地）/ remote / local / hash
EMBEDDING_BACKEND=auto
# 远程向量模型（**只有平台真的实现了 /v1/embeddings 才填**；
# 留空 = 直接使用下面的本地 ONNX 模型。部分网关只有 /chat/completions，填了也会自动回退）
# 自建 vLLM / llama.cpp 时填其 --served-model-name，例如 Qwen3-Embedding-8B
# 阿里云百炼的 Qwen3-Embedding（8B）API 模型 ID 是 text-embedding-v4
EMBEDDING_MODEL=remote
# 远程 Embedding 服务地址（必须写到 /v1）；留空则沿用上面的 OPENAI_BASE_URL
# 本机 vLLM 示例：http://127.0.0.1:8001/v1
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=
# 远程服务密钥（本地 vLLM 无鉴权时随便填 EMPTY）
# 百炼 Key 在 https://bailian.console.aliyun.com 控制台「API-KEY」页创建（sk- 开头）
EMBEDDING_API_KEY=
# 查询指令前缀（仅检索侧加，入库不加）。Qwen3-Embedding 官方写法：
# Instruct: Given a web search query, retrieve relevant academic passages\nQuery:
EMBEDDING_QUERY_PREFIX=
# 单次请求超时（秒）：8B 首次加载可能 1-2 分钟
EMBEDDING_TIMEOUT=60
# 输出向量维度（0 = 服务端默认）。百炼 text-embedding-v4 可选 2048/1536/1024/768/512/256/128/64
EMBEDDING_DIMENSIONS=1024

# ---- 公式视觉 LaTeX 还原（可选增强，默认 auto）----
# auto = 已安装 pix2tex 就用（pip install pix2tex，含 torch CPU 约 1GB；权重自动下载约 100MB）
# off  = 只用内置的 Unicode 规则还原（零依赖，覆盖常用记号，未安装 pix2tex 时的默认行为）
ENABLE_LATEX_OCR=auto
# 本地语义模型（多语言，中英互查；首次运行自动下载到 EMBEDDING_CACHE_DIR）
# 本机 CPU 建议：Qwen/Qwen3-Embedding-0.6B-Q（1024 维，量化 ONNX，约 1.1GB）
EMBEDDING_LOCAL_MODEL=text-embedding-v4
# 本地模型的查询前缀（MiniLM / BGE 留空；Qwen3-Embedding 按官方格式填）
EMBEDDING_LOCAL_QUERY_PREFIX=
# 模型缓存目录（相对仓库根目录；答辩前先联网下载一次，之后可离线）
EMBEDDING_CACHE_DIR=models
# 断网/答辩演示设为 false：只读本地缓存，缺模型时回退哈希向量
EMBEDDING_ALLOW_DOWNLOAD=true
# ONNX 线程数（0 = 自动）与批量大小
EMBEDDING_THREADS=0
EMBEDDING_BATCH_SIZE=16
# 语义判重阈值（0 = 自动：语义 0.88 / 哈希 0.65）
DEDUP_SIM_THRESHOLD=0

# ---- 选填：网络与抓取 ----
# 仅 arXiv/PubMed/GitHub 等学术请求走此代理，不影响 LLM 接口
HTTPS_PROXY=https://dasho.xn--cp3a08l.com/api/v1/pq/af6d4debfdbe68b947e3b70c0edb5c75
# 后台定时抓取开关（false = 只手动刷新，演示/断网环境建议 false）
FETCH_ENABLED=true
FETCH_INTERVAL_HOURS=6
# 校园网/安全软件替换证书时保持 true（仅影响公开学术元数据请求）
ALLOW_INSECURE_TLS=true
